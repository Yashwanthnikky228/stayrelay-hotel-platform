{
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/customer/build/client",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/not-found" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
