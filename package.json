{
  "name": "stayrelay-hotel-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm dev:customer",
    "dev:api": "pnpm --filter @stayrelay/api dev",
    "build": "pnpm typecheck && pnpm -r --if-present build",
    "preview": "pnpm --filter @stayrelay/customer preview",
    "typecheck": "pnpm typegen && tsc --noEmit && pnpm -r --if-present typecheck",
    "dev:customer": "pnpm --filter @stayrelay/customer dev",
    "typegen": "pnpm -r --if-present typegen",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "@stayrelay/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/node": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "packageManager": "pnpm@11.19.0"
}
