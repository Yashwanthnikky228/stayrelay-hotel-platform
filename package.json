{
  "name": "stayrelay-hotel-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter @stayrelay/customer dev",
    "dev:api": "pnpm --filter @stayrelay/api dev",
    "build": "pnpm typecheck && pnpm --filter @stayrelay/customer build",
    "preview": "pnpm --filter @stayrelay/customer preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stayrelay/domain": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/node": "^5.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "packageManager": "pnpm@11.19.0"
}
